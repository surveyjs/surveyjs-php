APP_NAME="SurveyJS + Laravel"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- SurveyJS examples (config/surveyjs.php) ---
# Commercial steps (Dashboard, Creator, PDF) run without a key and show a licence banner
SURVEYJS_LICENSE_KEY=

# Section IV: SurveyJS Server, `docker compose up -d surveyjs` publishes it on localhost:3010
SURVEYJS_SERVICE_URL=http://localhost:3010
# IV.1: validate responses through the service (routes/examples/validate-response.php replaces save-response.php)
VALIDATE_RESPONSES=false
# IV.2: lint definitions through the service (routes/examples/lint-definition.php replaces the III.1 PUT)
LINT_DEFINITIONS=false

# IV.4: the service's AI provider for extraction (openai, anthropic or ollama); passed to it by Docker Compose
SURVEYJS_AI_PROVIDER=
SURVEYJS_AI_MODEL=
SURVEYJS_OLLAMA_BASE_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# III.3: machine translation in Creator through an OpenAI-compatible /chat/completions endpoint
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# I.8 and III.5: the WebSocket relays (`composer relay`, `composer edit-relay`)
RELAY_PORT=8081
EDIT_RELAY_PORT=8082
# Leave empty to use ws(s)://<page host>:<port>; set them to the proxy's origin when it serves the relays, e.g. wss://example.com
# (the pages add /ws/rooms/<id> and /ws/forms/<id>; see README: Behind a proxy)
RELAY_URL=
EDIT_RELAY_URL=

# Demo only: a private database copy per visitor, removed after 24 hours unused (the hosted demo)
DEMO_MODE=false